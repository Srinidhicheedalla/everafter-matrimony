PORT=5000

# Required. Long random string, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Optional. SQLite file, relative to backend/ (default: everafter.db), or :memory:
DB_PATH=

# Optional. Failed logins allowed per client + email before a temporary block
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# Optional. Comma-separated origins allowed to call the API (default: any)
CORS_ORIGIN=http://localhost:5173
